# Copy to .env.local and fill in. Never commit .env.local.

# Set in Vercel Preview and Production: jsdom requires CommonJS-to-ESM loading,
# which Vercel disables by default. A local dotenv file cannot set Node startup flags.
# https://vercel.com/docs/functions/runtimes/node-js/advanced-node-configuration
# NODE_OPTIONS=--experimental-require-module

# --- NextAuth ---------------------------------------------------------------
# The app's own URL. http://localhost:3000 in development, the real origin in
# production. NextAuth reads this from the environment itself, so it appears
# nowhere in the source.
NEXTAUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this value revokes every active JWT session in that environment.
NEXTAUTH_SECRET=

# --- OAuth providers --------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database ---------------------------------------------------------------
# Matches the MongoDB service in compose.yaml.
MONGODB_URI=mongodb://localhost:27018/exfil-zone-assistant?replicaSet=rs0&directConnection=true

# --- Admin ------------------------------------------------------------------
# These accounts are promoted to admin on sign-in, checked in
# api/auth/[...nextauth]. This is how the first admin is created; after that an
# existing admin can grant roles. All three are optional. Promotion requires a verified provider
# email; the policy is implemented in lib/auth/oauth-sign-in.ts.
ADMIN_EMAIL_1=
ADMIN_EMAIL_2=
ADMIN_EMAIL_3=

# --- Rate limiting (optional) -----------------------------------------------
# Vercel KV is used only when NODE_ENV is production AND both of these are set.
# Without them the limiter falls back to an in-memory store, which on serverless
# is per-instance. Development is always in-memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Production without both KV variables keeps working on the in-memory limiter, but the admin
# health view reports the limiter as "misconfigured" and a cold start logs an error. Per-instance
# limits are not shared limits.
#
# Which header carries the client address for anonymous limits. A forwarded header is only
# trustworthy when the ingress overwrites whatever the client sent — name the one this
# deployment's proxy guarantees. Unset, x-forwarded-for then x-real-ip are tried.
RATE_LIMIT_TRUSTED_IP_HEADER=

# Deployment, session rotation, index rollout and recovery: docs/BACKEND_OPERATIONS.md.
# db:bootstrap is loopback-only; db:sync previews the configured target and --apply changes indexes.
