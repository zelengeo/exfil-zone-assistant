{
  "name": "exfil-zone-assistant",
  "version": "2.0.4",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "npm run db:prepare:local && tsx scripts/run-with-local-mongodb.ts dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:test": "tsx scripts/test-mongodb-connection.ts",
    "db:test:local": "tsx scripts/run-with-local-mongodb.ts db:test -- --transaction",
    "db:sync": "tsx scripts/sync-mongodb-indexes.ts",
    "db:bootstrap:local": "tsx scripts/run-with-local-mongodb.ts db:bootstrap",
    "db:up": "docker compose up -d --wait mongodb",
    "db:ui": "docker compose --profile tools up -d --wait mongo-express",
    "db:down": "docker compose down",
    "db:prepare:local": "npm run db:up && npm run db:bootstrap:local && npm run db:test:local",
    "db:bootstrap": "tsx scripts/bootstrap-local-mongodb.ts",
    "db:retire-corrections": "tsx scripts/retire-correction-data.ts",
    "db:strip-oauth-tokens": "tsx scripts/strip-oauth-tokens.ts",
    "db:strip-oauth-tokens:local": "tsx scripts/run-with-local-mongodb.ts db:strip-oauth-tokens",
    "db:retire-corrections:local": "tsx scripts/run-with-local-mongodb.ts db:retire-corrections",
    "validate-data": "tsx scripts/validate-data.ts",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "render:og": "node scripts/render-og.mjs",
    "verify": "npm run lint && npm run type-check && npm test && npm run validate-data && npm run build",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify:local": "npm run db:prepare:local && tsx scripts/run-with-local-mongodb.ts verify"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@icons-pack/react-simple-icons": "^12.8.0",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@vercel/analytics": "^1.5.0",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fast-deep-equal": "^3.1.3",
    "isomorphic-dompurify": "^2.26.0",
    "lucide-react": "^0.511.0",
    "mongodb": "^6.17.0",
    "mongoose": "^8.16.2",
    "next": "16.3.4",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.60.0",
    "recharts": "^3.1.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^20.19.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
}
